+# ---- aiter gemm_a16w4 加速路径 (BW10, group_size=32) ----
+# 设计: process_weights_after_loading (非编译路径) 预处理权重 + 预查 config,
+# 构造一个绑定了固定 config 的 launch 函数 (allow_in_graph) 存到 layer。
+# apply_weights 调用该 launch 函数, 对 torch.compile dynamo 友好 (无 graph break)。
+_AITER_MOD = None
+_AWQ_INV = [0, 2, 4, 6, 1, 3, 5, 7]  # GPTQ->AWQ 列重排 (每8列)
+
+
+def _load_aiter_gemm_mod():
+    """加载 aiter gemm_a16w4 triton kernel (绕过 aiter __init__ JIT)。"""
+    global _AITER_MOD
+    if _AITER_MOD is not None:
+        return _AITER_MOD
+    aiter_root = os.environ.get("AITER_ROOT", "/usr/local/lib/python3.10/dist-packages")
+    pkg = types.ModuleType("aiter")
+    pkg.__path__ = [aiter_root + "/aiter"]
+    pkg.__spec__ = importlib.util.spec_from_file_location(
+        "aiter", aiter_root + "/aiter/__init__.py",
+        submodule_search_locations=[aiter_root + "/aiter"])
+    pkg.logger = logging.getLogger("aiter")
+    sys.modules["aiter"] = pkg
+    for sub in ["aiter.ops", "aiter.ops.triton", "aiter.ops.triton.utils"]:
+        m = types.ModuleType(sub)
+        m.__path__ = [aiter_root + "/" + sub.replace(".", "/")]
+        sys.modules[sub] = m
+
+    def _load(n, p):
+        s = importlib.util.spec_from_file_location(n, p)
+        m = importlib.util.module_from_spec(s)
+        sys.modules[n] = m
+        s.loader.exec_module(m)
+        return m
+    _load("aiter.ops.triton.utils.core",
+          aiter_root + "/aiter/ops/triton/utils/core.py")
+    _load("aiter.ops.triton.utils.arch_info",
+          aiter_root + "/aiter/ops/triton/utils/arch_info.py")
+    s = importlib.util.spec_from_file_location(
+        "aiter.ops.triton.gemm_a16w4",
+        aiter_root + "/aiter/ops/triton/gemm_a16w4.py")
+    m = importlib.util.module_from_spec(s)
+    sys.modules["aiter.ops.triton.gemm_a16w4"] = m
+    s.loader.exec_module(m)
+    _AITER_MOD = m
+    print("[triton_w4a16] aiter gemm_a16w4 加载成功", file=sys.stderr)
+    return m
+
+
+def _gptq_to_awq_packed(b_q_gptq, qzeros_gptq):
+    """GPTQ [K,N//8] int32 (N-packed) -> AWQ [K,N//8] int32 (列重排)"""
+    K, N8 = b_q_gptq.shape
+    N = N8 * 8
+    shifts = torch.arange(8, device=b_q_gptq.device, dtype=torch.int32) * 4
+    w = ((b_q_gptq.unsqueeze(-1) >> shifts) & 0xF).reshape(K, N)
+    perm = (torch.arange(N // 8, device=b_q_gptq.device)[:, None] * 8
+            + torch.tensor(_AWQ_INV, device=b_q_gptq.device)).reshape(-1)
+    w_awq = w[:, perm].contiguous()
+    b_q_awq = torch.sum((w_awq.view(K, N8, 8) & 0xF) << shifts,
+                        dim=2, dtype=torch.int32).contiguous()
+    KG = qzeros_gptq.shape[0]
+    z = ((qzeros_gptq.unsqueeze(-1) >> shifts) & 0xF).reshape(KG, N)
+    z_awq = z[:, perm].contiguous()
+    qzeros_awq = torch.sum((z_awq.view(KG, N8, 8) & 0xF) << shifts,
+                           dim=2, dtype=torch.int32).contiguous()
+    return b_q_awq, qzeros_awq
+
+
+def _make_aiter_launch_fn(N, K, G):
+    """为指定形状构造一个绑定了固定 config 的 aiter gemm launch 函数。
+    用 torch.library.custom_op 注册成不透明 op, 对 torch.compile (dynamo+inductor) 友好。"""
+    mod = _AITER_MOD
+    configs = mod.get_w4a16_awq_gemm_configs(N, K, G)
+    kernel = mod.awq_gemm_kernel
+    impl = mod.awq_gemm_triton_impl
+
+    def _aiter_impl(input, qweight, scales, qzeros):
+        M = input.shape[0]
+        if configs:
+            best_m = min(configs.keys(), key=lambda x: abs(x - M))
+            config = dict(configs[best_m])
+        else:
+            config = {
+                "BLOCK_SIZE_M": 16, "BLOCK_SIZE_N": 128, "BLOCK_SIZE_K": 32,
+                "SCHEDULER": 0, "SPLITK": 1, "D_SHAPE": (M, N), "D_DTYPE": 16,
+                "DP_TILES": 0, "DANGLING_TILES": 0, "NUM_CUS": 0,
+                "NUM_CUS_STREAMK": 0,
+                "NUM_GROUPS": (32 + G - 1) // G, "USE_REDUCE_KERNEL": False,
+            }
+        d_shape = list(config["D_SHAPE"])
+        d_shape[-2] = M
+        config["D_SHAPE"] = d_shape
+        return impl(input, qweight, scales, qzeros, config, config.copy(), kernel)
+
+    # 注册成 torch custom op (不透明, dynamo/inductor 不 trace 内部)
+    op_name = f"gemm_a16w4_{N}_{K}_{G}"
+    try:
+        torch.library.define(f"aiter::{op_name}",
+                             "(Tensor input, Tensor qweight, Tensor scales, Tensor qzeros) -> Tensor")
+        torch.library.impl(f"aiter::{op_name}", "CUDA")(_aiter_impl)
+        # 注册 fake impl (让 dynamo 知道输出 shape/dtype, 避免 graph break)
+        @torch.library.register_fake(f"aiter::{op_name}")
+        def _fake(input, qweight, scales, qzeros):
+            return torch.empty((input.shape[0], qweight.shape[0]),
+                               dtype=input.dtype, device=input.device)
+    except Exception:
+        pass
+    op = getattr(torch.ops.aiter, op_name)
+
+    def _aiter_launch(input, qweight, scales, qzeros):
+        return op(input, qweight, scales, qzeros)
+
+    return _aiter_launch
+
+
+def _aiter_preprocess_layer(layer, w_q_name, w_s_name, w_zp_name, zp_bias=0):
+    """模型加载时 (process_weights_after_loading) 预处理 aiter 权重并缓存到 layer。
+    非编译路径, 可自由使用动态逻辑。
+
+    zp_bias: 对称量化 (uint4b8) 的零点偏移, 通常为 8。对称量化无显式 zp 张量,
+    但 aiter kernel dequant 算式为 (w - zeros) * scales, 需要造一个全 zp_bias 的
+    zp 张量, 使其等价于原生对称量化 (w - 8) * scale。非对称量化 zp_bias=0。
+    """
+    mod = _load_aiter_gemm_mod()
+    w_q = getattr(layer, w_q_name)       # [K, N//8] int32 (GPTQ N-packed)
+    w_s = getattr(layer, w_s_name)       # [K//G, N] fp16
+    w_zp = getattr(layer, w_zp_name, None)  # [K//G, N//8] int32 (GPTQ N-packed); 对称量化可能无 zp
+    # 对称量化无 zp: 造全 zp_bias 的 zp (每个 int32 pack 8 个 4bit zp_bias)。
+    # aiter dequant (w - zeros)*scales, zeros=zp_bias(8) 时 == (w-8)*scale,
+    # 与 uint4b8 对称量化等价。8 = 0b1000, 8 个 8 pack 成 0x88888888。
+    if w_zp is None:
+        # 8 个 4bit zp_bias pack 进一个 int32: 0x88888888 (zp_bias=8 时)。
+        # 用 int32 负数表示避免 Python 大 int 溢出 (0x88888888 作为有符号 int32 = -2005315832)。
+        packed_bias = zp_bias & 0xF
+        packed_bias = packed_bias | (packed_bias << 4) | (packed_bias << 8) \
+            | (packed_bias << 12) | (packed_bias << 16) | (packed_bias << 20) \
+            | (packed_bias << 24) | (packed_bias << 28)
+        # 截断到 int32 有符号范围
+        packed_bias = packed_bias & 0xFFFFFFFF
+        if packed_bias >= 0x80000000:
+            packed_bias -= 0x100000000
+        w_zp = torch.full((w_s.data.shape[0], w_q.data.shape[1]),
+                          packed_bias, dtype=torch.int32, device=w_q.data.device)
+    w_q_data = w_q.data if hasattr(w_q, "data") else w_q
+    w_zp_data = w_zp.data if hasattr(w_zp, "data") else w_zp
+    b_q_awq, qzeros_awq = _gptq_to_awq_packed(w_q_data, w_zp_data)
+    aq, az = mod.awq_reorder_and_repack(b_q_awq, qzeros_awq)
+    # 推断 N, K, G
+    N = aq.shape[0]
+    K = aq.shape[1] * 2
+    G = K // az.shape[0]
+    launch_fn = _make_aiter_launch_fn(N, K, G)
+    layer._aiter_w4a16_cache = {
+        "aq": aq.contiguous(),          # [N, K//2] int8
+        "az": az.contiguous(),          # [K//G, N//2] int8
+        "scales": (w_s.data if hasattr(w_s, "data") else w_s).contiguous(),
+        "launch": launch_fn,
+    }
+    # aiter 路径只用 _aiter_w4a16_cache (aq/az/scales), 不再读原始 w_q/w_zp。
+    # 释放原始 repack 后的 qweight [K, N//8] int32 (~13.5GB) 避免 OOM (单卡 32GB)。
+    del w_q_data, b_q_awq, qzeros_awq
+    replace_parameter(layer, w_q_name, None)
+    if w_zp_name is not None and getattr(layer, w_zp_name, None) is not None:
+        replace_parameter(layer, w_zp_name, None)
+    torch.cuda.empty_cache()
+
+
+# 模块加载时若启用 patch, 立即加载 aiter (在编译路径外)
+# 默认启用 (装了 patch 就生效); 设 VLLM_AITER_W4A16_PATCH=0 可关掉走 vllm 原生 triton
+if os.environ.get("VLLM_AITER_W4A16_PATCH", "1") != "0":
+    try:
+        _load_aiter_gemm_mod()
+    except Exception as e:
+        print(f"[triton_w4a16] aiter 加载失败, 回退到 vllm triton: {e}",
+              file=sys.stderr)
+

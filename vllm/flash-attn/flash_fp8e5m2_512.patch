 };
 
+// E4M3 reuses the same compact-LDS pipeline as E5M2: the raw FP8 bytes are loaded into LDS
+// without expansion and dequantized to BF16 in registers (e4m3x2_to_bf16x2) at read time.
+template <>
+struct FwdInputPipeline<fp8_e4m3, BFloat16> {
+    static constexpr bool kUseCompactLds = true;
+};
+
 // E5M2 and FP16 share sign/exponent/mantissa positions. Expand two bytes into FP16 words, convert to FP32, and retain
 // the high BF16 words. Finite E5M2 values are exact in BF16; FP16 NaNs remain BF16 NaNs without payload canonicalizing.
 __forceinline__ __device__ uint32_t e5m2x2_to_bf16x2(uint16_t input) {
@@ -26,6 +33,19 @@ __forceinline__ __device__ uint32_t e5m2x2_to_bf16x2(uint16_t input) {
     return (__builtin_bit_cast(uint32_t, value0) >> 16) | (__builtin_bit_cast(uint32_t, value1) & 0xffff0000u);
 }
 
+// E4M3 has no bit-layout overlap with FP16/BF16, so unlike e5m2x2_to_bf16x2 we must dequant each byte through the
+// software __e4m32float path (intrinsic.h) and then pack two BF16 values. The layout matches e5m2x2_to_bf16x2:
+// low byte -> low BF16, high byte -> high BF16.

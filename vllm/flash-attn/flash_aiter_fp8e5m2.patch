+@functools.lru_cache
+def _get_unit_descale(device: torch.device) -> torch.Tensor:
+    """A unit (1.0) descale tensor cached per device.
+
+    flash varlen_fwd_unified fp8 decode requires q/k/v descale tensors to be
+    passed even when no scaling is needed; a unit descale makes the fp8 path
+    a pure bit-cast (numerically a no-op). Cached per device so it is safe to
+    reuse during CUDA graph capture.
+    """
+    return torch.tensor([1.0], device=device)
